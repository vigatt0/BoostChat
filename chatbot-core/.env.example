# Aplicação
PORT=3001
NODE_ENV=development

# CORS - URLs permitidas (separadas por vírgula)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# OpenAI / GPT Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4

# Firebase Admin Configuration
# Cole aqui o JSON completo do service account em uma única linha
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project-id"}

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Pinecone Configuration (opcional para memória vetorial)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_ENVIRONMENT=your_pinecone_environment
PINECONE_INDEX=boostchat-memory

# Webhook Secret (para validar requisições do site-vendas)
WEBHOOK_SECRET=your_webhook_secret_here
